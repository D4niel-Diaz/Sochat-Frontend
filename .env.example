# Laravel API. Leave unset in development to use the Vite proxy (/api -> 127.0.0.1:8000).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# WebSocket server (Socket.IO)
VITE_WEBSOCKET_URL=http://localhost:3001
# REST polling intervals (ms), used only when the WebSocket is unavailable
VITE_POLLING_INTERVAL_MESSAGES=2000
VITE_POLLING_INTERVAL_MATCHING=3000
